## 3. Pseudocode Implementation

The following pseudocode assumes a C-like environment with a `millis()` function returning milliseconds. It uses a **non-blocking** design.

```c
/* Configuration Constants */
#define SAMPLE_INTERVAL_MS   1000    // 1 Hz sampling
#define WARNING_HYST_MS      5000    // Wait 5s before clearing warning
#define FAULT_THRESHOLD_CNT  3       // 3 consecutive out-of-range for fault
#define ADC_MAX              4095    // 12-bit ADC
#define V_REF                5.0     // Reference Voltage (V)
#define V_SENSITIVITY        0.01    // Volts per °C (Example: LM35)
#define V_OFFSET             0.5     // 0.5V = 0°C Offset (Example)

/* Global State */
float moving_avg_buffer[3];
int16_t avg_index = 0;
int16_t fault_count = 0;
int16_t last_status = STATUS_UNKNOWN;
uint32_t last_sample_time = 0;

/* Status Enums */
typedef enum {
    STATUS_UNKNOWN = 0,
    STATUS_NORMAL,
    STATUS_WARNING,
    STATUS_FAULT,
    STATUS_ERROR
} SystemStatus_t;

/* Helper: Get Moving Average */
float get_moving_average() {
    // Sum the last 3 valid samples
    float sum = 0;
    for(int i=0; i<3; i++) sum += moving_avg_buffer[i];
    return sum / 3.0;
}

/* Main Loop */
void main_loop() {
    uint32_t current_time = millis();

    // Check Sampling Interval
    if ((current_time - last_sample_time) >= SAMPLE_INTERVAL_MS) {
        last_sample_time = current_time;

        // 1. Acquire Raw Data
        int16_t raw_adc = read_adc_pin(); // Returns 0 to 4095

        // 2. Error Handling: Check for Sensor Disconnect/Short
        if (raw_adc <= 0 || raw_adc >= ADC_MAX) {
            fault_count = FAULT_THRESHOLD_CNT; // Trigger Fault immediately on wiring error
            last_status = STATUS_FAULT;
            log_alert("SENSOR_READ_ERROR: %d", raw_adc);
            return; // Skip processing
        }

        // 3. Signal Conditioning: Raw -> Engineering Units
        // V = (Raw / ADC_MAX) * V_REF
        // Temp = (V - V_OFFSET) / V_SENSITIVITY
        float voltage = (raw_adc / (float)ADC_MAX) * V_REF;
        float temp_c = (voltage - V_OFFSET) / V_SENSITIVITY;

        // 4. Noise Filtering (Sliding Window)
        moving_avg_buffer[avg_index] = temp_c;
        avg_index = (avg_index + 1) % 3;
        float temp_filtered = get_moving_average();

        // 5. Threshold Evaluation
        SystemStatus_t current_status = STATUS_NORMAL;

        if (temp_filtered < 0.0 || temp_filtered > 60.0) {
            current_status = STATUS_FAULT;
            fault_count++;
        } 
        else if (temp_filtered < 10.0 || temp_filtered > 40.0) {
            current_status = STATUS_WARNING;
            // Warning logic: No counter, just flag
        } 
        else {
            current_status = STATUS_NORMAL;
            fault_count = 0; // Reset fault counter on recovery
        }

        // 6. Reporting Logic (Debounce via State Change)
        if (current_status != last_status) {
            if (current_status == STATUS_FAULT && fault_count < FAULT_THRESHOLD_CNT) {
                // In a real system, we might wait for count here. 
                // Here we simplify: Status change triggers log.
                // NOTE: For strict glitch immunity, move fault_count check to report block.
            }
            
            // Report
            log_system_status(current_status, temp_filtered);
            
            // Update State
            last_status = current_status;
            fault_count = 0; // Reset counter on status change to avoid rapid flip-flopping
        }
    }

    // ... Other non-blocking tasks ...
}
```

